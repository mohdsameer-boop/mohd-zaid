</main>

<footer>© 2026 Your Name. All rights reserved.</footer>

<script>
// Drifting particles with faint connecting lines
const c = document.getElementById('bg'), x = c.getContext('2d');
const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
let W, H, dots = [];
function size(){
  W = c.width = innerWidth; H = c.height = innerHeight;
  dots = Array.from({length: Math.min(90, Math.floor(W * H / 16000))}, () => ({
    x: Math.random() * W, y: Math.random() * H,
    vx: (Math.random() - .5) * .35, vy: (Math.random() - .5) * .35
  }));
}
function draw(){
  x.clearRect(0, 0, W, H);
  for (const d of dots){
    if (!reduce){ d.x += d.vx; d.y += d.vy; }
    if (d.x < 0 || d.x > W) d.vx *= -1;
    if (d.y < 0 || d.y > H) d.vy *= -1;
    x.fillStyle = 'rgba(255,59,59,.7)';
    x.fillRect(d.x, d.y, 2, 2);
  }
  for (let i = 0; i < dots.length; i++) for (let j = i + 1; j < dots.length; j++){
    const dx = dots[i].x - dots[j].x, dy = dots[i].y - dots[j].y, dist = Math.hypot(dx, dy);
    if (dist < 130){
      x.strokeStyle = `rgba(255,59,59,${.14 * (1 - dist / 130)})`;
      x.beginPath(); x.moveTo(dots[i].x, dots[i].y); x.lineTo(dots[j].x, dots[j].y); x.stroke();
    }
  }
  if (!reduce) requestAnimationFrame(draw);
}
addEventListener('resize', () => { size(); if (reduce) draw(); });
size(); draw();
</script>
</body>
</html>
