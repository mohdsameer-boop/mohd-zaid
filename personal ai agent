<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Your Name – AI Systems Engineer</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#07060b; --panel:#0f0d16; --line:#2a2433; --text:#ece9f2; --muted:#9a93a8; --red:#ff3b3b; --glow:rgba(255,59,59,.18);
  --font:"Space Grotesk",system-ui,-apple-system,"Segoe UI",sans-serif;
}
*{box-sizing:border-box;margin:0}
html{scroll-behavior:smooth;scroll-padding-top:72px}
body{background:var(--bg);color:var(--text);font:400 1rem/1.65 var(--font)}
a{color:inherit;text-decoration:none}
:focus-visible{outline:2px solid var(--red);outline-offset:3px}
#bg{position:fixed;inset:0;z-index:0;pointer-events:none}
header{position:sticky;top:0;z-index:10;display:flex;justify-content:space-between;align-items:center;padding:16px clamp(20px,5vw,64px);background:rgba(7,6,11,.8);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
.logo{font-weight:700;letter-spacing:.02em}
nav{display:flex;gap:clamp(12px,3vw,32px);font-size:.95rem;color:var(--muted)}
nav a:hover{color:var(--red)}
main{position:relative;z-index:1}
section{max-width:1080px;margin:0 auto;padding:clamp(72px,12vw,140px) clamp(20px,5vw,40px)}
h1{font-size:clamp(2.6rem,8vw,5.6rem);line-height:1.02;font-weight:700;letter-spacing:-.03em;max-width:14ch}
h2{font-size:clamp(1.8rem,4.5vw,3rem);line-height:1.1;letter-spacing:-.02em;margin-bottom:28px}
h3{font-size:1.25rem;margin-bottom:8px}
p{color:var(--muted);max-width:62ch}
.hero p{margin-top:24px;font-size:1.15rem}
.btns{display:flex;gap:14px;margin-top:36px;flex-wrap:wrap}
.btn{padding:13px 26px;border:1px solid var(--line);border-radius:6px;font-weight:500;transition:.2s}
.btn.primary{background:var(--red);border-color:var(--red);color:#fff}
.btn:hover{box-shadow:0 0 28px var(--glow);border-color:var(--red)}
.stats{display:flex;gap:40px;flex-wrap:wrap;margin-top:56px}
.stats b{display:block;font-size:2rem;color:var(--red)}
.stats span{color:var(--muted);font-size:.9rem}
.grid{display:grid;gap:20px;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));margin-top:36px}
.card{background:var(--panel);border:1px solid var(--line);border-left:3px solid var(--red);border-radius:8px;padding:28px}
.card ul{margin-top:14px;padding-left:18px;color:var(--muted);font-size:.95rem}
.matrix .card{border-left-width:1px;border-top:3px solid var(--red)}
.tag{display:inline-block;margin-top:16px;padding:3px 12px;border:1px solid var(--line);border-radius:99px;font-size:.8rem;color:var(--muted);margin-right:6px}
.contact{text-align:center}
.contact h2,.contact p{margin-left:auto;margin-right:auto}
.contact .btns{justify-content:center}
footer{position:relative;z-index:1;text-align:center;padding:32px;color:var(--muted);font-size:.85rem;border-top:1px solid var(--line)}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{transition:none!important}}
</style>
</head>
<body>
